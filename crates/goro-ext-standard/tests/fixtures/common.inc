<?php
// Shared helpers for the fixture drivers. Each call prints one line:
//   <func> <arg> <arg> ... = <result> [<diag> ...]
// Values: s<hex> string, i<int> int, T/F bool, N null, f<repr> float,
// a<count>{<key>=<value>,...} array, X<class>:<hex message> exception.
// Diagnostics: W<hex> warning, n<hex> notice, D<hex> deprecation.
error_reporting(-1);
ini_set('display_errors', '0');
$GLOBALS['diags'] = [];
set_error_handler(function ($no, $str) {
    $k = match ($no) {
        E_WARNING, E_USER_WARNING => 'W',
        E_NOTICE, E_USER_NOTICE => 'n',
        E_DEPRECATED, E_USER_DEPRECATED => 'D',
        default => '?' . $no,
    };
    $GLOBALS['diags'][] = $k . bin2hex($str);
    return true;
});

function e($v): string {
    if (is_string($v)) return 's' . bin2hex($v);
    if (is_int($v)) return 'i' . $v;
    if (is_bool($v)) return $v ? 'T' : 'F';
    if (is_null($v)) return 'N';
    if (is_float($v)) return 'f' . var_export($v, true);
    if (is_array($v)) {
        $p = [];
        foreach ($v as $k => $x) $p[] = e($k) . '=' . e($x);
        return 'a' . count($v) . '{' . implode(',', $p) . '}';
    }
    return '?' . gettype($v);
}

// Big inputs are printed once: label($s, 'name') makes arguments equal to
// $s print as g<name>. Names "u8:A-B" and "bytes:A-B" are generated by the
// reader (see tests/common/mod.rs); others get an "#input <name> <hex>" line.
$GLOBALS['labels'] = [];
function label(string $s, string $name): string {
    $GLOBALS['labels'][$s] = $name;
    if (!preg_match('/^(u8|bytes):/', $name)) echo "#input $name ", bin2hex($s), "\n";
    return $s;
}
function ea($v): string {
    if (is_string($v) && isset($GLOBALS['labels'][$v])) return 'g' . $GLOBALS['labels'][$v];
    return e($v);
}

function run(string $name, ...$args): void {
    $GLOBALS['diags'] = [];
    try {
        $res = e($name(...$args));
    } catch (Throwable $t) {
        $res = 'X' . get_class($t) . ':' . bin2hex($t->getMessage());
    }
    $line = $name . ' ' . implode(' ', array_map('ea', $args)) . ' = ' . $res;
    foreach ($GLOBALS['diags'] as $d) $line .= ' ' . $d;
    echo $line, "\n";
}

// Deterministic pseudo-random generator (xorshift32), so the inputs do not
// depend on PHP's mt_rand implementation.
$GLOBALS['rng'] = 0x12345678;
function rnd(int $n): int {
    $x = $GLOBALS['rng'];
    $x ^= ($x << 13) & 0xffffffff;
    $x ^= $x >> 17;
    $x ^= ($x << 5) & 0xffffffff;
    $GLOBALS['rng'] = $x;
    return $x % $n;
}
function rnd_str(array $alphabet, int $maxlen): string {
    $len = rnd($maxlen + 1);
    $s = '';
    for ($i = 0; $i < $len; $i++) $s .= $alphabet[rnd(count($alphabet))];
    return $s;
}

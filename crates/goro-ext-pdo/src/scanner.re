// The SQL scanners of ext/pdo (pdo_sql_parser.re) and ext/pdo_mysql
// (mysql_sql_parser.re), generated by re2rust from the same rules.
//
// `s` is the query followed by a NUL byte (YYLIMIT is its length); a scan
// starts at `tok` and returns the token type and the position after it.
//
// Regenerate with: re2rust --no-generation-date --no-version -o scanner.rs scanner.re

#![allow(unused_assignments, unused_unsafe, clippy::all)]

use super::{EOI, T_BIND, T_BIND_POS, T_TEXT};

/*!re2c
    re2c:define:YYCTYPE = u8;
    re2c:define:YYPEEK = "s[cursor]";
    re2c:define:YYSKIP = "cursor += 1;";
    re2c:define:YYBACKUP = "marker = cursor;";
    re2c:define:YYRESTORE = "cursor = marker;";
    re2c:define:YYLESSTHAN = "limit - cursor < @@";
    re2c:define:YYFILL = "if limit - 1 <= cursor { return (EOI, cursor); }";
    re2c:define:YYFILL:naked = 1;
    re2c:yyfill:enable = 1;
*/

/// default_scanner (pdo_sql_parser.re)
pub fn default_scanner(s: &[u8], tok: usize) -> (i32, usize) {
    let limit = s.len();
    let mut cursor = tok;
    let mut marker = tok;
    /*!re2c
    BINDCHR		= [:][a-zA-Z0-9_]+;
    QUESTION	= [?];
    COMMENTS	= ("/*"([^*]+|[*]+[^/*])*[*]*"*/"|"--".*);
    SPECIALS	= [:?"'/-];
    MULTICHAR	= ([:]{2,}|[?]{2,});
    ANYNOEOF	= [\001-\377];

    (["]((["]["])|ANYNOEOF\["])*["])		{ return (T_TEXT, cursor); }
    (['](([']['])|ANYNOEOF\['])*['])		{ return (T_TEXT, cursor); }
    MULTICHAR								{ return (T_TEXT, cursor); }
    BINDCHR									{ return (T_BIND, cursor); }
    QUESTION								{ return (T_BIND_POS, cursor); }
    SPECIALS								{ return (T_TEXT, tok + 1); }
    COMMENTS								{ return (T_TEXT, cursor); }
    (ANYNOEOF\SPECIALS)+ 					{ return (T_TEXT, cursor); }
    */
}

/// pdo_mysql_scanner (mysql_sql_parser.re)
pub fn mysql_scanner(s: &[u8], tok: usize) -> (i32, usize) {
    let limit = s.len();
    let mut cursor = tok;
    let mut marker = tok;
    /*!re2c
    M_BINDCHR		= [:][a-zA-Z0-9_]+;
    M_QUESTION	= [?];
    M_COMMENTS	= ("/*"([^*]+|[*]+[^/*])*[*]*"*/"|(("--"[ \t\v\f\r])|[#]).*);
    M_SPECIALS	= [:?"'`/#-];
    M_MULTICHAR	= ([:]{2,}|[?]{2,});
    M_ANYNOEOF	= [\001-\377];

    (["]((["]["])|([\\]M_ANYNOEOF)|M_ANYNOEOF\["\\])*["]) { return (T_TEXT, cursor); }
    (['](([']['])|([\\]M_ANYNOEOF)|M_ANYNOEOF\['\\])*[']) { return (T_TEXT, cursor); }
    ([`]([`][`]|M_ANYNOEOF\[`])*[`])			{ return (T_TEXT, cursor); }
    M_MULTICHAR								{ return (T_TEXT, cursor); }
    M_BINDCHR									{ return (T_BIND, cursor); }
    M_QUESTION								{ return (T_BIND_POS, cursor); }
    M_SPECIALS								{ return (T_TEXT, tok + 1); }
    M_COMMENTS								{ return (T_TEXT, cursor); }
    (M_ANYNOEOF\M_SPECIALS)+ 					{ return (T_TEXT, cursor); }
    */
}

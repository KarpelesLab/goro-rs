# goro's default magic rules (magic(5) format), written for goro-rs from
# the format specifications cited with each rule; descriptions, mime types,
# extensions and Apple codes are the ones PHP 8.5's finfo reports (tests
# ext/fileinfo/tests and observation). Rules are tried in file order.

#------------------------------------------------------------------ images
# PNG (ISO/IEC 15948, 5.2 signature, 11.2.2 IHDR)
0	string	\x89PNG\r\n\x1a\n\0\0\0\x0dIHDR	PNG image data
!:mime	image/png
!:ext	png
>16	belong	x	\b, %d x
>20	belong	x	%d,
>24	byte	x	%d-bit
>25	byte	0	grayscale,
>25	byte	2	\b/color RGB,
>25	byte	3	colormap,
>25	byte	4	gray+alpha,
>25	byte	6	\b/color RGBA,
>28	byte	0	non-interlaced
>28	byte	1	interlaced

# GIF (GIF89a specification, 17. Header, 18. Logical Screen Descriptor)
0	string	GIF8
>4	string	7a	GIF image data, version 8%s,
!:mime	image/gif
!:apple	8BIMGIFf
!:ext	gif
>>6	leshort	>0	%d x
>>8	leshort	>0	%d
>4	string	9a	GIF image data, version 8%s,
!:mime	image/gif
!:apple	8BIMGIFf
!:ext	gif
>>6	leshort	>0	%d x
>>8	leshort	>0	%d

# BMP (Microsoft BITMAPFILEHEADER; BITMAPINFOHEADER, V4 and V5 headers)
0	name	bmp-info
>18	lelong	x	\b, %d x
>22	lelong	x	%d x
>28	leshort	x	%d
>34	lelong	>0	\b, image size %d
>38	lelong	>0	\b, resolution %d x
>>42	lelong	x	%d px/m
>50	lelong	>0	\b, %d important colors
>2	lelong	x	\b, cbSize %d
>10	lelong	x	\b, bits offset %d
0	string	BM
>14	ulelong	40	PC bitmap, Windows 3.x format
!:mime	image/bmp
!:apple	????BMPp
!:ext	bmp/ico
>>0	use	bmp-info
>14	ulelong	108	PC bitmap, Windows 95/NT4 and newer format
!:mime	image/bmp
!:ext	bmp
>>0	use	bmp-info
>14	ulelong	124	PC bitmap, Windows 98/2000 and newer format
!:mime	image/bmp
!:ext	bmp
>>0	use	bmp-info
>14	ulelong	12	PC bitmap, OS/2 1.x format
!:mime	image/bmp
!:ext	bmp
>>18	leshort	x	\b, %d x
>>20	leshort	x	%d x
>>24	leshort	x	%d
>>2	lelong	x	\b, cbSize %d
>>10	lelong	x	\b, bits offset %d

# Photoshop (Adobe Photoshop File Formats Specification: file header)
0	string	8BPS
>4	beshort	1	Adobe Photoshop Image
!:mime	image/vnd.adobe.photoshop
!:ext	psd
>>18	belong	x	\b, %d x
>>14	belong	x	%d,
>>24	beshort	0	bitmap
>>24	beshort	1	grayscale
>>24	beshort	2	indexed
>>24	beshort	3	RGB
>>24	beshort	4	CMYK
>>24	beshort	7	multichannel
>>24	beshort	8	duotone
>>24	beshort	9	lab
>>12	beshort	1
>>>22	beshort	x	\b, %d-bit channel
>>12	beshort	>1
>>>12	beshort	x	\b, %dx
>>>22	beshort	x	%d-bit channels

# IFF (EA IFF 85; ILBM bitmap header BMHD)
0	string	FORM
>8	string	ILBM	IFF data, ILBM interleaved image
>>12	string	BMHD
>>>20	beshort	x	\b, %d x
>>>22	beshort	x	%d

# Shockwave Flash (SWF File Format Specification 19: header)
0	string	FWS	Macromedia Flash data,
!:mime	application/x-shockwave-flash
!:ext	swf
>3	byte	x	version %d
0	string	CWS	Macromedia Flash data (compressed),
!:mime	application/x-shockwave-flash
!:ext	swf
>3	byte	x	version %d
0	string	ZWS	Macromedia Flash data (LZMA compressed),
!:mime	application/x-shockwave-flash
!:ext	swf
>3	byte	x	version %d

#------------------------------------------------------- audio and video
# RIFF (Microsoft RIFF; WAVE and AVI forms)
0	string	RIFF	RIFF (little-endian) data
>8	string	WAVE	\b, WAVE audio
!:mime	audio/x-wav
!:ext	wav/wave
>8	string	AVI\040	\b, AVI
!:mime	video/x-msvideo
!:ext	avi

# ISO base media (ISO/IEC 14496-12 4.3 FileTypeBox)
4	string	ftyp	ISO Media
>8	string	qt\040\040	\b, Apple QuickTime movie, Apple QuickTime (.MOV/QT)
!:mime	video/quicktime
>8	string	mp42	\b, MP4 v2 [ISO 14496-14]
!:mime	video/mp4
>8	string	isom	\b, MP4 Base Media v1 [ISO 14496-12:2003]
!:mime	video/mp4
>8	string	mp41	\b, MP4 v1 [ISO 14496-1:ch13]
!:mime	video/mp4
>8	string	M4A\040	\b, Apple iTunes ALAC/AAC-LC (.M4A) Audio
!:mime	audio/x-m4a
!:ext	m4a
>8	string	3gp	\b, MPEG v4 system, 3GPP
!:mime	video/3gpp
>8	string	avif	\b, AVIF Image
!:mime	image/avif
!:ext	avif
>8	string	mif1	\b, HEIF Image
!:mime	image/heif
>8	string	heic	\b, HEIF Image HEVC Main or Main Still Picture Profile
!:mime	image/heic
!:ext	heic

# MPEG program stream (ISO/IEC 13818-1 pack header)
0	belong	0x000001ba	MPEG sequence
!:mime	video/mpeg
!:ext	vob/evo/mpg/mpeg

# Ogg (RFC 3533)
0	string	OggS	Ogg data

# FLAC (FLAC format specification, stream marker)
0	string	fLaC	FLAC audio bitstream data
!:mime	audio/flac

# Adaptive Multi-Rate (RFC 4867 section 5: storage format)
0	string	#!AMR\n	Adaptive Multi-Rate Codec (GSM telephony)
!:mime	audio/amr
!:ext	amr
0	string	#!AMR-WB\n	Adaptive Multi-Rate Codec Wideband (GSM telephony)
!:mime	audio/amr-wb
!:ext	awb

# DSD Stream File (Sony "DSF File Format Specification" 1.01)
0	string	DSD\040
>28	string	fmt\040	DSF audio bitstream data
!:mime	audio/x-dsf
>>60	ulelong	x	\b, %d bit
>>52	ulelong	1	\b, mono
>>52	ulelong	2	\b, stereo
>>52	ulelong	>2	\b, %d channels
>>56	ulelong	2822400	\b, "DSD 64"
>>56	ulelong	5644800	\b, "DSD 128"
>>56	ulelong	11289600	\b, "DSD 256"
>>56	ulelong	x	%d Hz
>>44	ulelong	0	\b, no compression
>>20	ulequad	>0
>>>(20.q)	string	ID3
>>>>&0	ubyte	x	\b, ID3 version 2.%d
>>>>&1	ubyte	x	\b.%d

# Matroska / WebM (EBML RFC 8794 header, DocType element 0x4282)
0	belong	0x1a45dfa3
>4	search/4096	\x42\x82
>>&1	string	webm	WebM
!:mime	video/webm
>>&1	string	matroska	Matroska data
!:mime	video/x-matroska
!:ext	mkv/mka/mks/mk3d
0	belong	0x1a45dfa3	EBML file

#--------------------------------------------------------------- fonts
# WOFF (W3C WOFF File Format 1.0, 3. WOFF Header)
0	string	wOFF	Web Open Font Format
!:mime	font/woff
>4	belong	0x00010000	\b, TrueType
>4	string	OTTO	\b, CFF
>4	string	true	\b, TrueType
>8	belong	x	\b, length %d
>20	beshort	x	\b, version %d
>22	beshort	x	\b.%d
# WOFF2 (W3C WOFF File Format 2.0)
0	string	wOF2	Web Open Font Format (Version 2)
!:mime	font/woff2
!:ext	woff2
>4	belong	0x00010000	\b, TrueType
>4	string	OTTO	\b, CFF
>8	belong	x	\b, length %d
>20	beshort	x	\b, version %d
>22	beshort	x	\b.%d
# OpenType with CFF outlines (OpenType specification, table directory)
0	string	OTTO	OpenType font data
!:mime	application/vnd.ms-opentype

#--------------------------------------------------- archives, compression
# gzip (RFC 1952 2.3.1)
0	string	\x1f\x8b	gzip compressed data
!:mime	application/gzip
>3	byte&0x0c	0x08
>>10	string	x	\b, was "%s"
>4	uledate	>0	\b, last modified: %s
>8	byte	2	\b, max compression
>8	byte	4	\b, max speed
>9	byte	0	\b, from FAT filesystem (MS-DOS, OS/2, NT)
>9	byte	3	\b, from Unix
>9	byte	7	\b, from Macintosh
>9	byte	11	\b, from NTFS filesystem (NT)
# ISIZE: the last four bytes (needs the whole file)
>-0	offset	>48
>>-4	ulelong	x	\b, original size modulo 2^32 %u
# bzip2 (stream header "BZh" and the block size digit)
0	string	BZh
>3	byte	>0x30
>>3	byte	<0x3a	bzip2 compressed data
!:mime	application/x-bzip2
!:ext	bz2
>>>3	byte	x	\b, block size = %c00k
# XZ (The .xz File Format 1.0.4, 2.1.1 Stream Header)
0	string	\xfd7zXZ\0	XZ compressed data, checksum
!:mime	application/x-xz
!:ext	xz
>7	byte&0xf	0x0	NONE
>7	byte&0xf	0x1	CRC32
>7	byte&0xf	0x4	CRC64
>7	byte&0xf	0xa	SHA-256
# LZ4 frame (LZ4 Frame Format Description 1.6.x)
0	lelong	0x184d2204	LZ4 compressed data (v1.4+)
!:mime	application/x-lz4
!:ext	lz4
# compress(1) LZW
0	string	\x1f\x9d	compress'd data
!:mime	application/x-compress
!:ext	Z
# Zstandard (RFC 8878 3.1.1; legacy frames v0.2 to v0.7)
0	lelong	0xfd2fb522	Zstandard compressed data (v0.2)
!:mime	application/zstd
!:ext	zst
0	lelong	0xfd2fb523	Zstandard compressed data (v0.3)
!:mime	application/zstd
!:ext	zst
0	lelong	0xfd2fb524	Zstandard compressed data (v0.4)
!:mime	application/zstd
!:ext	zst
0	lelong	0xfd2fb525	Zstandard compressed data (v0.5)
!:mime	application/zstd
!:ext	zst
0	lelong	0xfd2fb526	Zstandard compressed data (v0.6)
!:mime	application/zstd
!:ext	zst
0	lelong	0xfd2fb527	Zstandard compressed data (v0.7)
!:mime	application/zstd
!:ext	zst
>4	byte&3	1
>>5	ubyte	x	\b, Dictionary ID: %u
>4	byte&3	2
>>5	uleshort	x	\b, Dictionary ID: %u
>4	byte&3	3
>>5	ulelong	x	\b, Dictionary ID: %u
>4	default	x	\b, Dictionary ID: None
0	lelong	0xfd2fb528	Zstandard compressed data (v0.8+)
!:mime	application/zstd
!:ext	zst
>4	byte&0x23	0x01
>>6	ubyte	x	\b, Dictionary ID: %u
>4	byte&0x23	0x02
>>6	uleshort	x	\b, Dictionary ID: %u
>4	byte&0x23	0x03
>>6	ulelong	x	\b, Dictionary ID: %u
>4	byte&0x23	0x21
>>5	ubyte	x	\b, Dictionary ID: %u
>4	byte&0x23	0x22
>>5	uleshort	x	\b, Dictionary ID: %u
>4	byte&0x23	0x23
>>5	ulelong	x	\b, Dictionary ID: %u
>4	default	x	\b, Dictionary ID: None
# Zstandard dictionary (RFC 8878 5. Dictionary Format)
0	lelong	0xec30a437	Zstandard dictionary
!:mime	application/x-zstd-dictionary
>4	ulelong	x	(ID %u)
# RAR (RARLAB technote: marker block)
0	string	Rar!\x1a\x07\0	RAR archive data
!:mime	application/vnd.rar
!:ext	rar/cbr
0	string	Rar!\x1a\x07\x01\0	RAR archive data, v5
!:mime	application/vnd.rar
!:ext	rar/cbr
# 7-Zip (7z format: signature header)
0	string	7z\xbc\xaf\x27\x1c	7-zip archive data,
>6	byte	x	version %d
>7	byte	x	\b.%d
# ar (POSIX ar archive magic)
0	string	=!<arch>\n	current ar archive
!:mime	application/x-archive
!:ext	a/lib/ar
# ARJ (ARJ TECHNOTE: main header, file type 2; DOS date in the creation
# time stamp)
0	leshort	0xea60
>10	byte	2	ARJ archive data
!:mime	application/x-arj
!:ext	arj
>>5	byte	x	\b, v%d,
>>6	byte	>1	minimum %d to extract,
>>8	byte&0x01	0x01	password-protected (v0),
>>8	byte&0x10	0x10	slash-switched,
>>9	byte	>0	security version %d,
>>14	uleshort&0x1f	x	created %d
>>14	uleshort&0x01e0	0x0020	jan
>>14	uleshort&0x01e0	0x0040	feb
>>14	uleshort&0x01e0	0x0060	mar
>>14	uleshort&0x01e0	0x0080	apr
>>14	uleshort&0x01e0	0x00a0	may
>>14	uleshort&0x01e0	0x00c0	jun
>>14	uleshort&0x01e0	0x00e0	jul
>>14	uleshort&0x01e0	0x0100	aug
>>14	uleshort&0x01e0	0x0120	sep
>>14	uleshort&0x01e0	0x0140	oct
>>14	uleshort&0x01e0	0x0160	nov
>>14	uleshort&0x01e0	0x0180	dec
>>15	ubyte/2	x	1980+%d,
>>(4.b+4)	string	x	original name: %s,
>>7	byte	0	os: MS-DOS
>>7	byte	1	os: PRIMOS
>>7	byte	2	os: Unix
>>7	byte	3	os: Amiga
>>7	byte	4	os: Macintosh
>>7	byte	5	os: OS/2
>>7	byte	6	os: Apple ][ GS
>>7	byte	7	os: Atari ST
>>7	byte	8	os: NeXT
>>7	byte	9	os: VAX/VMS
>>7	byte	10	os: WIN95
>>7	byte	11	os: WIN32

#------------------------------------------------------------ firmware
# Android vdex (ART: "vdex" magic, verifier deps and dex section version
# strings, dex file count and verifier deps size)
0	name	vdex-fields
>4	string	x	verifier deps version: %s,
>8	string	x	dex section version: %s,
>12	ulelong	x	number of dex files: %d,
>16	ulelong	x	verifier deps size: %d
0	string	vdex	Android vdex file,
>0	use	vdex-fields
0	string	wdex	Android vdex file, being processed by dex2oat,
>0	use	vdex-fields
# UF2 (Microsoft UF2 specification: 32-byte block header)
0	string	UF2\n
>4	ulelong	0x9e5d5157	UF2 firmware image
>>8	ulelong&0x2000	0x2000
>>>28	ulelong	0x1c5f21b0	\b, family ESP32
>>>28	ulelong	0xbfdd4eee	\b, family ESP32-S2
>>>28	ulelong	0xc47e5767	\b, family ESP32-S3
>>>28	ulelong	0xd42ba06c	\b, family ESP32-C3
>>>28	ulelong	0xe48bff56	\b, family Raspberry Pi RP2040
>>>28	ulelong	0x68ed2b88	\b, family Microchip (Atmel) SAMD21
>>>28	ulelong	0x55114460	\b, family Microchip (Atmel) SAMD51
>>>28	ulelong	0xada52840	\b, family Nordic NRF52840
>>>28	default	x
>>>>28	ulelong	x	\b, family 0x%x
>>8	ulelong&0x2000	0
>>>28	ulelong	x	\b, file size 0x%x
>>12	ulelong	x	\b, base address %08x
>>24	ulelong	x	\b, %u total blocks
# IBM PCjr cartridge images (header text written by PCjr cartridge tools)
0	string	PCjr\ Cartridge\ image\ file	PCjr Cartridge image
# HDD Raw Copy Tool images (Pascal strings: tool name, version, model,
# serial)
0	string	\x11HDD\ Raw\ Copy\ Tool
>0	pstring	x	%s
>0x100	pstring	x	%s
>0x200	pstring	x	- HD model: %s
>0x400	pstring	x	serial: %s
# Garmin FIT (FIT SDK: 14-byte file header, ".FIT"; file_id message;
# times count from 1989-12-31 00:00 UTC)
8	string	.FIT	FIT Map data
>0x23	ubelong	x	\b, unit id %u
>0x27	ulelong	x	\b, serial %u
>0x2b	uledate+631065600	x	\b, %s
>0x2f	uleshort	1	\b, manufacturer 1 (garmin)
>0x2f	uleshort	!1	\b, manufacturer %u
>0x31	uleshort	x	\b, product %u
>0x35	ubyte	1	\b, type 1 (Device)
>0x35	ubyte	2	\b, type 2 (Settings)
>0x35	ubyte	3	\b, type 3 (Sport/Sport Settings)
>0x35	ubyte	4	\b, type 4 (Activity)
>0x35	ubyte	5	\b, type 5 (Workout)
>0x35	ubyte	6	\b, type 6 (Course)

#------------------------------------------------------------ documents
# PostScript (PostScript Language Document Structuring Conventions)
0	string	%!PS	PostScript document text
!:mime	application/postscript
!:ext	ps
# Rich Text Format (RTF 1.9.1 specification, header)
0	string	{\\rtf	Rich Text Format data, version
!:mime	text/rtf
!:ext	rtf
>5	string	1	1
# OLE2 compound document signature ([MS-CFB] 2.2 header) when the
# directory could not be read
0	string	\xd0\xcf\x11\xe0\xa1\xb1\x1a\xe1	OLE 2 Compound Document

# JPEG 2000 (ISO/IEC 15444-1 I.5: signature box and file type brand;
# A.4.1 SOC + SIZ markers of a bare codestream)
0	string	\0\0\0\x0cjP\040\040\r\n\x87\n
>20	string	jp2\040	JPEG 2000 Part 1 (JP2)
!:mime	image/jp2
!:ext	jp2
0	belong	0xff4fff51	JPEG 2000 codestream
!:mime	image/x-jp2-codestream
!:ext	j2c/j2k/jpc

# SQLite (SQLite database file format, 1.3.1 header)
0	string	SQLite\ format\ 3\0
>16	ubeshort	>0	SQLite 3.x database
!:mime	application/vnd.sqlite3
!:ext	sqlite/sqlite3/db/db3/dbe/sdb/help

#------------------------------------------------------------ executables
# ELF (System V ABI, ELF header e_ident)
0	string	\x7fELF	ELF
>4	byte	1	32-bit
>4	byte	2	64-bit
>5	byte	1	LSB
>5	byte	2	MSB
>16	leshort	2	executable
!:mime	application/x-executable
>16	leshort	3	shared object
!:mime	application/x-sharedlib
>16	leshort	1	relocatable
!:mime	application/x-object
# Java class files / Mach-O universal (JVM spec 4.1 magic)
0	belong	0xcafebabe
>4	belong	>30	compiled Java class data,
!:mime	application/x-java-applet
>>6	beshort	x	version %d
>>4	beshort	x	\b.%d
# MS-DOS executables (MZ header)
0	string	MZ
>0x18	uleshort	<0x40	MS-DOS executable
!:mime	application/x-dosexec
>0x18	uleshort	>0x3f
>>(0x3c.l)	string	PE\0\0	PE executable
!:mime	application/vnd.microsoft.portable-executable

#-------------------------------------------------------------- disks
# Apple Partition Map driver descriptor ("Inside Macintosh: Devices",
# Block0: sbSig 0x4552, sbBlkSize)
0	belong&0xffff01ff	0x45520000	Apple Driver Map
>2	beshort	x	\b, blocksize %d
>4	belong	x	\b, blockcount %d

#---------------------------------------------------------- text formats
0	string/t	#\ Magic	magic text file for file(1) cmd
!:mime	text/x-file
0	string/t	--TEST--	PHP core test
!:ext	phpt
# PHP scripts start with an open tag (PHP manual: Basic syntax)
0	regex/c	\^<\\?(php|[\ \t\r\n])	PHP script
!:mime	text/x-php
# XML 1.0/1.1 declaration (W3C XML 2.8); SVG root element (W3C SVG 1.1)
0	string/t	\<?xml\ version=
>&0	search/4096	\<svg	SVG Scalable Vector Graphics image
!:mime	image/svg+xml
!:ext	svg
>&0	default	x
>>15	string/t	1.0	XML 1.0 document
!:mime	text/xml
>>15	string/t	1.1	XML 1.1 document
!:mime	text/xml
>>15	default	x	XML document
!:mime	text/xml
0	string/t	\<svg	SVG Scalable Vector Graphics image
!:mime	image/svg+xml
!:ext	svg
# HTML (WHATWG HTML 13.1: the DOCTYPE, the html element)
0	search/1/c	\<!doctype\ html	HTML document
!:mime	text/html
0	search/1/c	\<html	HTML document
!:mime	text/html
0	string/t	0\ HEAD	GEDCOM genealogy text
!:mime	text/x-gedcom
>0	search/4096	GEDC\n2\ VERS\040
>>&0	string	x	version %s
0	string/b	#!\ /usr/bin/perl	Perl script text executable
!:mime	text/x-perl
0	string/b	#!/usr/bin/perl	Perl script text executable
!:mime	text/x-perl
0	regex	\^#![\ \t]*(/[^\ \t\r\n]*/)?(env[\ \t]+)?python[0-9.]*([\ \t\r\n]|$)	Python script
!:mime	text/x-script.python
0	regex	\^#![\ \t]*/bin/sh([\ \t\r\n]|$)	POSIX shell script
!:mime	text/x-shellscript
0	regex	\^#![\ \t]*(/[^\ \t\r\n]*/)?(env[\ \t]+)?bash([\ \t\r\n]|$)	Bourne-Again shell script
!:mime	text/x-shellscript
0	string/t	#!
>2	string/T	x	a %s script
0	regex	\^BEGIN[\ \t]*\\{	awk or perl script
0	string/t	From:\ 	news or mail
!:mime	message/rfc822
0	string/t	Return-Path:	SMTP mail
!:mime	message/rfc822
0	string/t	diff\ 	diff output
!:mime	text/x-diff
!:ext	diff/patch
0	string/t	begin\040
>6	regex	\^[0-7]{3}\ 	uuencoded or xxencoded text
>>10	string	x	\b, file name "%s"
0	string	-----BEGIN\ PGP\ MESSAGE-	PGP message
!:mime	application/pgp-encrypted
!:ext	asc

# X BitMap (X11 "bitmap" C source: #define <name>_width / _height)
0	search/2048	#define\040
>&0	regex	[A-Za-z0-9_]*_width\040+	xbm image
>>&0	regex	[0-9]+	(%sx
>>>&0	string/t	\n#define\040
>>>>&0	search/80	_height\040
>>>>>&0	regex	[0-9]+	\b%s)

# PEM keys (RFC 7468 textual encodings)
0	string	-----BEGIN\ RSA\ PRIVATE\ KEY-----	PEM RSA private key
!:mime	text/x-ssl-private-key
0	string	-----BEGIN\ PUBLIC\ KEY-----	OpenSSH public key
!:mime	text/x-ssh-public-key

# PHP phar archives (PHP manual: Phar file format: the signature flags
# and "GBMB" end the file)

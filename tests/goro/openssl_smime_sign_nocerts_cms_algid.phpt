-----END CERTIFICATE-----");
// PKCS7_NOCERTS leaves out the signer and the extra certificates
foreach ([PKCS7_NOATTR|PKCS7_BINARY, PKCS7_NOATTR|PKCS7_BINARY|PKCS7_NOCERTS] as $fl) {
  openssl_pkcs7_sign("$t.in", "$t.out", $cert, $key, [], $fl, $extra);
  $o = preg_replace('/----[0-9A-F]{32}/', '----B', file_get_contents("$t.out"));
  echo "pkcs7 $fl: ", strlen($o), " ", md5($o), "\n";
}
// CMS digest AlgorithmIdentifiers have no NULL parameters; CMS_NOCERTS
// keeps the extra certificates
foreach ([OPENSSL_CMS_NOATTR|OPENSSL_CMS_BINARY, OPENSSL_CMS_NOATTR|OPENSSL_CMS_BINARY|OPENSSL_CMS_NOCERTS] as $fl) {
  openssl_cms_sign("$t.in", "$t.out", $cert, $key, [], $fl, OPENSSL_ENCODING_DER, $extra);
  $o = file_get_contents("$t.out");
  echo "cms $fl: ", strlen($o), " ", md5($o), " ", bin2hex(substr($o, 0, 48)), "\n";
}
foreach (["in", "out", "extra"] as $s) @unlink("$t.$s");
?>

foreach ($certs as $n => $pem) {
  $c = @openssl_x509_read($pem);
  echo "$n: ", $c ? "read" : "false";
  if ($c) { $p = openssl_x509_parse($c); echo " v", $p['version'], " serial=", $p['serialNumberHex']; }
  $e = []; while ($x = openssl_error_string()) $e[] = $x;
  echo " [", implode(" | ", $e), "]\n";
}

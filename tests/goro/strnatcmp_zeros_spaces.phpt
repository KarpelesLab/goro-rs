--TEST--
strnatcmp()/strnatcasecmp() follow strnatcmp_ex()
--FILE--
<?php
foreach ([["a01","a1"],["a01","a001"],["0001","1.5"],["1.02","1.1"],["x2-y7","x2-y08"],["\nb","5"],["\ta","a"],["_","p"],["a","A"],["",""],["0","00"],[" 1","1"],["001","1"],["a","a "],["1 2","12"],["img12","img10"],["\v\fa","a"]] as [$a,$b]) {
  echo json_encode($a), " ", json_encode($b), " ", strnatcmp($a,$b), " ", strnatcasecmp($a,$b), "\n";
}
--EXPECT--
"a01" "a1" -1 -1
"a01" "a001" 1 1
"0001" "1.5" -1 -1
"1.02" "1.1" -1 -1
"x2-y7" "x2-y08" 1 1
"\nb" "5" 1 1
"\ta" "a" 0 0
"_" "p" -1 1
"a" "A" 1 0
"" "" 0 0
"0" "00" 0 0
" 1" "1" 0 0
"001" "1" 0 0
"a" "a " -1 -1
"1 2" "12" -1 -1
"img12" "img10" 1 1
"\u000b\fa" "a" 0 0

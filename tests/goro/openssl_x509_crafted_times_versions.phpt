  echo "$n: v", $p['version'], " serial=", $p['serialNumber'], "/", $p['serialNumberHex'], " ", $p['validFrom'], " ", $p['validTo'], " ", $p['validFrom_time_t'], " ", $p['validTo_time_t'], "\n";
  openssl_x509_export($pem, $t, false);
  preg_match_all('/(Version|Serial Number|Not Before|Not After) ?:(.*)/', $t, $m);
  foreach ($m[0] as $l) echo "  ", trim($l), "\n";

--TEST--
spl_classes() lists the SPL classes and interfaces in php-src's order
--FILE--
<?php
$a = spl_classes(); $b = $a; ksort($b); var_dump(array_keys($a) === array_keys($b));
foreach ($a as $k => $v) echo "$k\n";

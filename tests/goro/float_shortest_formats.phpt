--TEST--
Shortest float digits (zend_gcvt mode 0) in var_dump/var_export/json/serialize: padded digits, ties to even
--FILE--
<?php
$fs = [-86657511641105020.0, -(2.0**55), 2.0**60, 1e15, 1e16, 123456789012345678.0, 971374658691426.25, 0.1 + 0.2, 1e21, 1e22, -0.0, 5e-324, 1.7976931348623157e308, 2.0**53 + 1, 1.5e300, 4.35, 0.000021, 1e-7, 100.0, 1.0, 2.5e-5, 9007199254740993.0, 0.30000000000000004, 123456789.12345678];
foreach ($fs as $f) {
    var_dump($f);
    echo var_export($f, true), ' ', json_encode($f), ' ', serialize($f), ' ', $f, ' ', print_r($f, true), ' ', strval($f), "\n";
}
ini_set('precision', 17); echo 0.1, ' ', 1/3, "\n";
ini_set('serialize_precision', 5); var_dump(1/3); echo json_encode(1/3), "\n";

--TEST--
/ and % of ints and floats (fast path): int results, float results, LONG_MIN edge cases, division by zero
--FILE--
<?php
$vals = [0, 1, -1, 7, -7, 3, PHP_INT_MAX, PHP_INT_MIN, 2.5, -0.0, 0.0, 1e308, INF, NAN, -3.0];
foreach ($vals as $a) foreach ($vals as $b) {
    try { $d = $a / $b; } catch (DivisionByZeroError $e) { $d = 'DBZ'; }
    try { $m = @($a % $b); } catch (DivisionByZeroError|ArithmeticError $e) { $m = get_class($e); } catch (Throwable $e) { $m = get_class($e); }
    echo var_export($a, true), ' ', var_export($b, true), ' => ', var_export($d, true), ' | ', var_export($m, true), "\n";
}
function f($x, $y) { $s = 0; for ($i = 1; $i < 50; $i++) { $s += ($x * $i) % $y + intdiv($i, $y) + $x / $i; } return $s; }
var_dump(f(7, 3), f(-9, 4));

?>

--TEST--
Concatenation of strings, ints and other values
--FILE--
<?php
function c($a, $b) { return $a . $b; }
$vals = ['', 'x', '0', 0, 1, -42, PHP_INT_MAX, PHP_INT_MIN, 1.5, true, false, null, '1e3'];
foreach ($vals as $a) {
    foreach ($vals as $b) {
        echo var_export(c($a, $b), true), ' ';
    }
    echo "\n";
}
$s = 'abc';
$t = $s . '';
$u = '' . $s;
$s .= 'd';
echo "$t $u $s\n";
$n = 5;
echo "n=$n", ' ', $n . $n, ' ', 'a' . $n . 'b', "\n";
$x = "pre{$s}post{$n}";
echo $x, strlen($x), "\n";
echo $undefinedvar . 'z', "\n";
$arr = [1];
echo @($arr . 'x'), "\n";
class T { function __toString(): string { return 'T!'; } }
echo (new T) . '-' . 3, "\n";
$big = str_repeat('ab', 50);
echo strlen($big . $big), "\n";
for ($i = 0; $i < 3; $i++) { $acc = 'k' . $i . '_' . ($i * 2); echo $acc, ' '; }
echo "\n";
?>

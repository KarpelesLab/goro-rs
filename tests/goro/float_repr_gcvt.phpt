--TEST--
Float to string: zend_gcvt() digits for shortest and fixed precision
--FILE--
<?php
// zend_gcvt(): shortest round-trip digits (precision -1) and %.*G output
foreach ([4.9e-324, 1e-320, 2.2250738585072014e-308, 1.7976931348623157e308, 1e22, 1e17, 1e16,
          123456789012345678.0, 0.1 + 0.2, 1/3, -0.0, 1e-5, 0.0001, 5e-5, 1.5e300] as $f) {
    echo var_export($f, true), ' | ', json_encode($f), ' | ', serialize($f), ' | ', $f, "\n";
}
ini_set('precision', 17);
echo 0.1, ' ', 1/3, ' ', 4.9e-324, "\n";
ini_set('precision', 3);
echo 1234.5, ' ', 0.000123456, ' ', 99.95, "\n";
--EXPECT--
5.0E-324 | 5.0e-324 | d:5.0E-324; | 4.9406564584125E-324
1.0E-320 | 1.0e-320 | d:1.0E-320; | 9.9998886718268E-321
2.2250738585072014E-308 | 2.2250738585072014e-308 | d:2.2250738585072014E-308; | 2.2250738585072E-308
1.7976931348623157E+308 | 1.7976931348623157e+308 | d:1.7976931348623157E+308; | 1.7976931348623E+308
1.0E+22 | 1.0e+22 | d:1.0E+22; | 1.0E+22
1.0E+17 | 1.0e+17 | d:1.0E+17; | 1.0E+17
10000000000000000.0 | 10000000000000000 | d:10000000000000000; | 1.0E+16
1.2345678901234568E+17 | 1.2345678901234568e+17 | d:1.2345678901234568E+17; | 1.2345678901235E+17
0.30000000000000004 | 0.30000000000000004 | d:0.30000000000000004; | 0.3
0.3333333333333333 | 0.3333333333333333 | d:0.3333333333333333; | 0.33333333333333
-0.0 | -0 | d:-0; | -0
1.0E-5 | 1.0e-5 | d:1.0E-5; | 1.0E-5
0.0001 | 0.0001 | d:0.0001; | 0.0001
5.0E-5 | 5.0e-5 | d:5.0E-5; | 5.0E-5
1.5E+300 | 1.5e+300 | d:1.5E+300; | 1.5E+300
0.10000000000000001 0.33333333333333331 4.9406564584124654E-324
1.23E+3 0.000123 100

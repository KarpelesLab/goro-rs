--TEST--
iconv_mime_encode(): ISO-2022-JP escape sequences at word ends like glibc
--FILE--
<?php
$subjects = ["(,?日:日@=語Z語)", "日本語の件名です", "【重要】お知らせ：システムメンテナンスのご案内（2024年12月）", "Re: 会議の件について - 明日10時から", "テスト test テスト test テスト test テスト test テスト test テスト", "a日b本c語d"];
// glibc writes (and switches to) the escape sequence of a character that
// then has no room in the encoded word
foreach ($subjects as $s) {
    foreach (["B", "Q"] as $sc) {
        foreach ([24, 30, 33, 34, 41, 52, 76] as $l) {
            $r = @iconv_mime_encode("Subject", $s, ["scheme" => $sc, "output-charset" => "ISO-2022-JP", "line-length" => $l]);
            echo "$sc $l ", $r === false ? "FALSE" : $r, "\n";
        }
    }
}

--TEST--
number_format() rounds with _php_math_round() (PHP_ROUND_HALF_UP) before formatting
--FILE--
<?php
// number_format(): _php_math_round() then "%.*F" (ext/standard/math.c)
foreach ([[1.005, 2], [2.675, 2], [0.285, 2], [1.955, 2], [-0.4, 0], [-0.0, 2], [0.5, 0], [1.5, 0],
          [2.5, 0], [-1234.567, 2], [1234.5678, -2], [-1234.5678, -2], [0.129, 2], [1e15 + 0.5, 1],
          [123456.789, 4], [INF, 2], [-INF, 0], [NAN, 1], [1e300, 2], [0.1, 20]] as [$n, $d]) {
    echo var_export($n, true), ", $d => ", number_format($n, $d), "\n";
}
echo number_format(1234567.891, 2, ',', '.'), "\n";
echo number_format(-1234.567, 2, '', ' '), "\n";
echo number_format(1234.5, 2, 'dec', 'thou'), "\n";
echo strlen(number_format(0.5, 400)), "\n";
--EXPECT--
1.005, 2 => 1.01
2.675, 2 => 2.68
0.285, 2 => 0.29
1.955, 2 => 1.96
-0.4, 0 => 0
-0.0, 2 => 0.00
0.5, 0 => 1
1.5, 0 => 2
2.5, 0 => 3
-1234.567, 2 => -1,234.57
1234.5678, -2 => 1,200
-1234.5678, -2 => -1,200
0.129, 2 => 0.13
1000000000000000.5, 1 => 1,000,000,000,000,000.5
123456.789, 4 => 123,456.7890
INF, 2 => inf
-INF, 0 => inf
NAN, 1 => nan
1.0E+300, 2 => 1,000,000,000,000,000,052,504,760,255,204,420,248,704,468,581,108,159,154,915,854,115,511,802,457,988,908,195,786,371,375,080,447,864,043,704,443,832,883,878,176,942,523,235,360,430,575,644,792,184,786,706,982,848,387,200,926,575,803,737,830,233,794,788,090,059,368,953,234,970,799,945,081,119,038,967,640,880,074,652,742,780,142,494,579,258,788,820,056,842,838,115,669,472,196,386,865,459,400,540,160.00
